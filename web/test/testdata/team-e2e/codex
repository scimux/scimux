#!/usr/bin/python3
# Synthetic offline JSON-RPC fixture. Never delegates to an installed CLI.
import json, os, sys, time
if os.path.basename(sys.argv[0]) != 'codex': sys.exit(127)
if sys.argv[1:] == ['--version']:
    print('synthetic-codex 1.0'); sys.exit(0)
if sys.argv[1:3] == ['debug', 'models']:
    print(json.dumps({'data':[]})); sys.exit(0)
if sys.argv[1:3] != ['app-server', '--stdio']:
    sys.exit(2)
thread=0
turn=0
def emit(v): print(json.dumps(v),flush=True)
def note(method,params): emit({'method':method,'params':params})
for line in sys.stdin:
    req=json.loads(line); method=req.get('method'); params=req.get('params',{})
    if method == 'initialize': result={'userAgent':'synthetic'}
    elif method == 'thread/start':
        thread+=1; result={'thread':{'id':'synthetic-thread-'+str(thread),'path':''},'approvalPolicy':'on-request'}
    elif method == 'turn/start':
        turn+=1; tid='synthetic-turn-'+str(turn); text='\n'.join(x.get('text','') for x in params.get('input',[]))
        with open(os.environ['SCIMUX_SYNTHETIC_COUNTER']+'.attempts','a') as out: out.write(json.dumps({'method':method,'text':text})+'\n')
        if '[reject-dispatch]' in text:
            if '[delay-dispatch]' in text: time.sleep(3)
            emit({'id':req['id'],'error':{'code':-32603,'message':'Synthetic dispatch refusal'}})
            continue
        if '[delay-dispatch]' in text: time.sleep(3)
        with open(os.environ['SCIMUX_SYNTHETIC_COUNTER'],'a') as out: out.write(json.dumps({'method':method,'text':text})+'\n')
        emit({'id':req['id'],'result':{'turn':{'id':tid}}})
        note('turn/started',{'threadId':params['threadId'],'turn':{'id':tid}})
        note('item/completed',{'threadId':params['threadId'],'turnId':tid,'item':{'type':'agentMessage','id':'msg-'+str(turn),'text':'Synthetic response '+str(turn)}})
        note('turn/completed',{'threadId':params['threadId'],'turn':{'id':tid,'status':'completed'}})
        continue
    elif method == 'turn/interrupt':
        with open(os.environ['SCIMUX_SYNTHETIC_COUNTER']+'.controls','a') as out: out.write(json.dumps({'method':method})+'\n')
        result={}
    elif method == 'model/list': result={'data':[]}
    else: result={}
    if 'id' in req: emit({'id':req['id'],'result':result})
