builds/
# anchored to the repo root: these name the built binary, not any path
# component. Unanchored they also match the directory cmd/scimux/, which
# silently kept the build entrypoint out of git.
/scimux-*
/scimux

# locally captured transcript/protocol fixtures (regenerate with
# scripts/capture-fixtures.sh; they contain personal environment snapshots
# even after scrubbing, so they stay out of the public repo)
internal/transcript/testdata/real-*.jsonl
internal/acp/codex/testdata/real-*.ndjson
internal/acp/testdata/real-*.ndjson
internal/acp/muse/testdata/real-*.ndjson
internal/acp/muse/schema/

# Only README.md, AGENTS.md, CLAUDE.md, SECURITY.md, and the published docs/
# set are tracked. Every other markdown file (design/planning intermediates,
# working notes) is a local or in-repo-but-unpublished document — keep them
# all out of git. The list below must name every tracked .md: this is a
# deny-by-default list, so a doc missing from it cannot be added to docs/
# without -f, and a new sibling beside one is invisible to `git add docs/`.
# (`git ls-files '*.md'` is the check.) An entry for a file that does not
# exist is not harmless either — it reads as a promise the repo does not
# keep; `!docs/fare-v2-p1-grounding.md` sat here naming a document that was
# never tracked at all.
*.md
!README.md
!AGENTS.md
!CLAUDE.md
!SECURITY.md
!docs/http-api.md
!docs/rendezvous-protocol-sync.md
!docs/protocol/rendezvous-v1.md
!docs/invariants/claude-hooks.md
!docs/invariants/attention.md

attic/

.agent
.agents
.codex
.claude

# server runtime log (nohup ./scimux …)
nohup.out

# local E2E scratch script, not part of the test suite
scripts/mm-e2e-image-delivery.sh
